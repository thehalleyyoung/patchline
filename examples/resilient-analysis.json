{
  "version": "patchline.resilient-analysis/v1",
  "name": "resilient distributed analysis gate",
  "claim": "Patchline adds a resilient distributed analysis mode that is distinct from deterministic work scheduling: it replays real run evidence for worker loss, hash-detected cache corruption, quarantine and rebuild, deterministic leases, partial network partitions, and accepted task completions. The gate proves every task completes exactly once, a lost-worker task is reassigned and accepted on a surviving worker, a corrupt cache entry is detected by hashing committed fixture bytes and rebuilt before use, and tasks affected by a recovered partition still make accepted progress.",
  "criteria": {
    "min_tasks": 3,
    "min_workers": 3,
    "require_worker_loss_recovery": true,
    "require_cache_quarantine": true,
    "require_cache_rebuild": true,
    "require_partition_recovery": true,
    "require_deterministic_leases": true,
    "require_no_duplicate_accepted_completion": true,
    "require_evidence_hashes": true
  },
  "workers": [
    {
      "id": "worker-a",
      "zone": "az-a",
      "initially_healthy": true
    },
    {
      "id": "worker-b",
      "zone": "az-b",
      "initially_healthy": true
    },
    {
      "id": "worker-c",
      "zone": "az-c",
      "initially_healthy": true
    }
  ],
  "tasks": [
    {
      "id": "accounts-backfill-risk",
      "repo": "patchline/self",
      "subpath": "examples/source-sql",
      "shard": "00",
      "expected_result_sha256": "sha256:3ce1d5a8ffea2f54e070f85e42a79d25498f8d4e20de1e7dce185e5d12eda60a",
      "evidence_paths": [
        "examples/resilient-analysis/evidence/runbook.md",
