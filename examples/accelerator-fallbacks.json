{
  "version": "patchline.accelerator-fallbacks/v1",
  "name": "Patchline deterministic accelerator-free fallbacks",
  "claim": "Patchline makes every learned component reproducible on ordinary CPU-only machines: the verifier discovers learned gate fixtures from the repository, requires a declared fallback for every discovered component, pins the learned-artifact catalog, pins the fallback implementation, pins public fixture inputs and outputs, rejects GPU or accelerator dependencies, rejects network access, requires a stable seed, requires two identical replay proofs that bind every component id to the pinned output digest, and checks each fallback stays within a declared parity drift bound. The gate mutates coverage, device, replay, hash, and parity controls so the claim is tested against real repository fixtures rather than accepted as documentation.",
  "criteria": {
    "required_component_ids": [
      "abstraction-selection-policy",
      "active-learning",
      "active-learning-loop",
      "adopter-active-learning",
      "adversarial-training-loop",
      "continual-learning-eval",
      "extractable-neuro-symbolic",
      "foundation-model-finetune",
      "human-trust-regression",
      "interpretability-probe",
      "learned-policy-safety-case",
      "learned-program-repair",
      "learned-risk-model",
      "live-learning-methodology",
      "mechanistic-decision-circuits",
      "neuro-symbolic-proof-search",
      "neuro-symbolic-verdict",
      "neurosymbolic-explanations",
      "online-learning-guard",
      "reproducible-rl-repair-policy",
      "reviewer-action-model",
      "rl-reviewer",
      "rl-rollout-sequencing",
      "schema-foundation-model",
      "schema-self-supervised-pretrain",
      "transfer-learning-study",
      "verified-learned-heuristics"
    ],
    "min_components": 27,
    "min_replay_artifacts": 2,
    "require_repository_discovery": true,
    "require_cpu_fallback": true,
    "require_accelerator_free": true,
    "require_no_network": true,
    "require_deterministic_replay": true,
    "require_stable_seed": true,
    "require_pinned_learned_artifact": true,
    "require_pinned_implementation": true,
    "require_pinned_inputs": true,
    "require_pinned_outputs": true,
    "require_parity_evidence": true,
    "require_evidence_hashes": true,
    "max_allowed_drift": 0.01
  },
