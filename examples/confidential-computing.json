{
  "version": "patchline.confidential-computing/v1",
  "name": "Patchline confidential-computing private corpus evaluation",
  "claim": "Patchline proves that private corpus analysis can be evaluated without pretending private data is public: each workload is bound to a verifiable confidential-computing enclave attestation, measured runtime image digest, measurement allowlist, key-release policy, encrypted inputs, no-network execution, redacted aggregate public outputs, retained private outputs, verifier reports, and deterministic replay evidence. The gate mutates the spec into missing quotes, missing verifier reports, wrong measurements, plaintext export, missing encrypted inputs, forged output manifests, network egress, unredacted outputs, policy/enclave mismatches, and missing replay evidence, then requires deterministic counterexamples instead of trusting a self-declared private analysis result.",
  "criteria": {
    "required_tee_kinds": [
      "sgx",
      "sev-snp"
    ],
    "min_enclaves": 2,
    "min_key_release_policies": 2,
    "min_workloads": 2,
    "require_attestation": true,
    "require_measurement_allowlist": true,
    "require_key_release_policy": true,
    "require_encrypted_inputs": true,
    "require_private_outputs": true,
    "require_no_plaintext_export": true,
    "require_no_network_egress": true,
    "require_verifier_evidence": true,
    "require_replay_evidence": true,
    "require_evidence_hashes": true
  },
