      "migrations": [
        {
          "path": "db/migrate/20260102020202_unsafe_contract.sql",
          "sql": "ALTER TABLE invoices ADD COLUMN external_id_shadow text; ALTER TABLE invoices DROP COLUMN total_cents;"
        }
      ]
    }
  ]
