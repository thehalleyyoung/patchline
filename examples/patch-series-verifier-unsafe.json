    "tables": [
      {
        "name": "invoices",
        "columns": [
          {"name": "id", "type": "uuid"},
          {"name": "customer_id", "type": "uuid"},
          {"name": "total_cents", "type": "integer"},
          {"name": "legacy_external_id", "type": "text"}
        ]
      }
    ]
  },
  "invariants": [
