{
  "version": "patchline.repository-size-stratification-gate/v1",
  "claim": "Patchline can stratify the real-repo catalog into repository-size/type strata (small apps, medium services, monorepos, and infrastructure-heavy repos) and prove that a representative real download from each stratum analyzes end-to-end with measured files, facts, and ranked risks.",
  "source_catalog": "examples/real-repo-catalog.json",
  "infrastructure_frameworks": [
    "Liquibase",
    "Flyway",
    "Bytebase migrator SQL",
    "Go SQL migrations",
    "golang-migrate",
    "Project-native SQL migrations"
  ],
  "required_strata": ["small-app", "medium-service", "monorepo", "infrastructure-heavy"],
  "minimum_total_facts": 200,
  "proof_slices": [
    {
      "stratum": "small-app",
      "repo": "lobsters/lobsters",
      "ref": "3b80b47aa5aaba37ec44413e7d1dc96fcf1585b6",
      "subpath": "db/migrate",
      "ecosystem": "Ruby"
    },
    {
      "stratum": "medium-service",
      "repo": "golang-migrate/migrate",
      "ref": "2bd822b3aad4e86f3028324a5b754fc6b4ea54a1",
      "subpath": "database/postgres/examples/migrations",
      "ecosystem": "Go"
    },
    {
      "stratum": "monorepo",
      "repo": "apache/airflow",
      "ref": "f72e4c417187335b3124a5cfe0766df32b5d6aba",
      "subpath": "airflow-core/src/airflow/migrations/versions",
      "ecosystem": "Python"
    },
    {
      "stratum": "infrastructure-heavy",
      "repo": "bytebase/bytebase",
      "ref": "0765652ea2dbdf8e93ae44bff5acafc1b97a92cc",
      "subpath": "backend/migrator/migration",
      "ecosystem": "Go"
    }
  ]
}
