{
  "version": "patchline.public-slo/v1",
  "name": "public uptime and reproducibility SLO report",
  "claim": "Patchline publishes a public uptime and reproducibility SLO report spanning hosted documentation, release and paper artifacts, evidence-marketplace exports, and corpus APIs. Every surface has a public endpoint and status page, fresh uptime probes, rerunnable reproducibility probes, hash-backed evidence artifacts, latency and incident budgets, deterministic report hashing, and explicit negative controls for missing status pages, stale probes, broken hashes, breached uptime, missing reproducibility, missing evidence, and unreviewed incidents. This turns public-good infrastructure health into a reproducible, citable artifact rather than a marketing promise.",
  "period": {
    "start": "2026-06-01T00:00:00Z",
    "end": "2026-06-03T12:00:00Z"
  },
  "criteria": {
    "required_kinds": ["hosted-docs", "artifacts", "marketplace-evidence", "corpus-api"],
    "min_surfaces": 4,
    "min_probes_per_surface": 3,
    "min_uptime_percent": 99,
    "min_reproducibility_percent": 100,
    "max_p95_latency_ms": 900,
    "max_probe_age_hours": 96,
    "max_incident_minutes": 30,
    "require_public_status_url": true,
    "require_reproducibility_probe": true,
    "require_incident_review": true,
    "require_evidence_hashes": true,
    "require_reproducibility_command": true
  },
