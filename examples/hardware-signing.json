    {
      "id": "recover-release-root",
      "kind": "recovery",
      "artifact_id": "patchline-release",
      "old_signer_id": "release-root",
      "new_signer_id": "release-root",
      "steps": [
        "unseal recovery share",
        "enroll replacement token",
        "verify old release signature",
        "publish recovery result"
      ],
      "started_at": "2026-06-03T11:00:00Z",
      "completed_at": "2026-06-03T11:21:00Z",
      "evidence_paths": [
        "examples/hardware-signing/drills/recovery.md"
      ],
      "result_paths": [
        "examples/hardware-signing/drills/recovery-result.json"
      ]
    },
    {
      "id": "revoke-gate-signer",
      "kind": "revocation",
      "artifact_id": "release-gate",
      "old_signer_id": "gate-signer",
      "new_signer_id": "certificate-signer",
      "steps": [
        "append revocation to ledger",
        "reject stale gate signature",
        "accept replacement threshold quorum"
      ],
      "started_at": "2026-06-03T12:00:00Z",
      "completed_at": "2026-06-03T12:16:00Z",
      "evidence_paths": [
        "examples/hardware-signing/drills/revocation.md"
      ],
      "result_paths": [
        "examples/hardware-signing/drills/revocation-result.json"
      ]
    }
  ],
  "evidence_paths": [
