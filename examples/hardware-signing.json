      "kind": "key_rotation",
      "artifact_id": "patchline-release",
      "old_signer_id": "release-root",
      "new_signer_id": "gate-signer",
      "steps": [
        "freeze release metadata",
        "enroll replacement hardware key",
        "re-sign gate artifact",
        "verify certificate log continuity"
      ],
      "started_at": "2026-06-03T10:00:00Z",
      "completed_at": "2026-06-03T10:18:00Z",
      "evidence_paths": [
