{
  "version": "patchline.hardware-signing/v1",
  "name": "Patchline hardware-backed release signing",
  "claim": "Patchline proves that release, gate, and certificate artifacts are not merely checksummed files: each artifact is bound to attested hardware-backed signing identities, threshold approval, certificate-log continuity, gate-report evidence, recovery shares, and replayed key-rotation, recovery, and revocation drills. The gate mutates the spec into forged hashes, missing signatures, missing attestations, lost recovery shares, absent certificate logs, absent gate reports, insufficient signer thresholds, and missing drill evidence, then requires deterministic counterexamples instead of trusting release metadata.",
  "criteria": {
    "required_artifact_kinds": [
      "release",
      "gate",
      "certificate"
    ],
    "min_signing_identities": 3,
    "min_artifacts_per_kind": 1,
    "require_hardware_backing": true,
    "require_attestation": true,
    "require_threshold_approval": true,
    "require_key_rotation_drill": true,
    "require_recovery_drill": true,
    "require_revocation_drill": true,
    "require_offline_root": true,
    "require_evidence_hashes": true
  },
  "signing_identities": [
    {
      "id": "release-root",
      "role": "offline-root",
      "hardware_type": "yubikey",
      "slot": "9c",
      "offline_root": true,
      "attestation_path": "examples/hardware-signing/attestations/release-root.json",
      "public_key_path": "examples/hardware-signing/keys/release-root.pub",
      "recovery_share_paths": [
        "examples/hardware-signing/recovery/release-root-a.share"
      ],
      "evidence_paths": [
        "examples/hardware-signing/evidence/release-window.md"
      ]
    },
    {
      "id": "gate-signer",
      "role": "gate-signer",
      "hardware_type": "hsm",
      "slot": "gate",
      "offline_root": false,
      "attestation_path": "examples/hardware-signing/attestations/gate-signer.json",
      "public_key_path": "examples/hardware-signing/keys/gate-signer.pub",
      "recovery_share_paths": [
        "examples/hardware-signing/recovery/gate-signer-a.share"
      ],
      "evidence_paths": [
        "examples/hardware-signing/evidence/gate-window.md"
      ]
    },
    {
      "id": "certificate-signer",
      "role": "certificate-signer",
      "hardware_type": "kms-hsm",
      "slot": "certificate",
      "offline_root": false,
      "attestation_path": "examples/hardware-signing/attestations/certificate-signer.json",
      "public_key_path": "examples/hardware-signing/keys/certificate-signer.pub",
      "recovery_share_paths": [
        "examples/hardware-signing/recovery/certificate-signer-a.share"
      ],
      "evidence_paths": [
        "examples/hardware-signing/evidence/certificate-window.md"
      ]
    }
  ],
  "signed_artifacts": [
