          ]
        }
      ],
      "negative_controls": [
        {
          "id": "translate-risk-id",
          "mutation": "Translate risk_id to riesgo_id in the localized text.",
          "expected_counterexample": "missing_preserved_technical_token and missing_preserved_equivalence_token"
        }
      ]
    },
    {
