{
  "version": "patchline.localized-teaching/v1",
  "name": "Patchline localized teaching examples",
  "claim": "Patchline localized teaching examples make migration-safety education global without weakening the evidence contract: every translation preserves byte-identical commands and identifiers, cites real evidence files, covers accessibility requirements, and includes a negative control that proves translated or inaccessible material fails deterministically.",
  "criteria": {
    "required_locales": [
      "es",
      "fr"
    ],
    "required_audiences": [
      "app-developer",
      "dba"
    ],
    "required_accessibility_checks": [
      "plain-language",
      "alt-text",
      "reading-order"
    ],
    "min_examples": 2,
    "min_translations_per_example": 2,
    "min_concepts_per_example": 2,
    "min_technical_terms_per_translation": 3,
    "min_equivalence_checks_per_translation": 2,
    "min_accessibility_checks_per_translation": 3,
    "require_technical_terms": true,
    "require_equivalence_checks": true,
    "require_accessibility_checks": true,
    "require_reproducible_command": true,
    "require_negative_control": true
  },
  "examples": [
    {
      "id": "app-developer-backfill-lab",
      "audience": "app-developer",
      "source_locale": "en",
      "title": "Backfill lab review",
      "source_text": "Run `make classroom-lab-kits-gate` before approving a NOT NULL backfill lesson. The Patchline report must keep `risk_id` and `evidence_hash` visible so learners can trace the gate.",
      "concepts": [
        "backfill completeness",
        "evidence-hash traceability"
      ],
      "evidence_paths": [
        "docs/classroom-lab-kits.md",
        "docs/a11y-i18n-output.md"
      ],
      "reproduce_commands": [
        "make localized-teaching-examples-gate",
        "make classroom-lab-kits-gate"
      ],
      "translations": [
        {
          "locale": "es",
          "title": "Revision de laboratorio de backfill",
          "text": "Ejecute `make classroom-lab-kits-gate` antes de aprobar una leccion de backfill NOT NULL. El informe Patchline debe mantener `risk_id` y `evidence_hash` visibles para que estudiantes puedan trazar el gate.",
          "technical_terms": [
            {
              "id": "patchline",
              "source": "Patchline",
              "translation": "Patchline",
              "must_preserve": true
            },
            {
              "id": "not-null",
              "source": "NOT NULL",
              "translation": "NOT NULL",
              "must_preserve": true
            },
            {
              "id": "risk-id",
              "source": "risk_id",
              "translation": "risk_id",
              "must_preserve": true
            }
          ],
          "equivalence_checks": [
            {
              "id": "command-preserved",
              "kind": "command-preservation",
              "source_quote": "`make classroom-lab-kits-gate`",
              "translated_quote": "`make classroom-lab-kits-gate`",
              "preserved_tokens": [
                "make classroom-lab-kits-gate"
              ]
            },
            {
              "id": "evidence-identifiers-preserved",
              "kind": "identifier-preservation",
              "source_quote": "`risk_id` and `evidence_hash`",
              "translated_quote": "`risk_id` y `evidence_hash`",
              "preserved_tokens": [
                "risk_id",
                "evidence_hash"
              ]
            }
          ],
          "accessibility_checks": [
            {
              "id": "plain-language",
              "type": "plain-language",
              "requirement": "Sentences keep the action, command, and evidence obligation explicit.",
              "evidence_paths": [
                "docs/a11y-i18n-output.md"
              ]
            },
            {
              "id": "alt-text",
              "type": "alt-text",
              "requirement": "Any screenshot alt text names the gate command and failing control.",
              "evidence_paths": [
                "docs/accessibility-conformance.md"
              ]
            },
            {
              "id": "reading-order",
              "type": "reading-order",
              "requirement": "The localized lesson preserves command-before-decision reading order.",
              "evidence_paths": [
                "docs/localized-teaching-examples.md"
              ]
            }
          ],
          "evidence_paths": [
            "docs/classroom-lab-kits.md"
          ]
        },
        {
          "locale": "fr",
          "title": "Revue de laboratoire de backfill",
          "text": "Executez `make classroom-lab-kits-gate` avant d'approuver une lecon de backfill NOT NULL. Le rapport Patchline doit garder `risk_id` et `evidence_hash` visibles afin que les apprenants puissent tracer le gate.",
