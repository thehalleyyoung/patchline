{
  "version": "patchline.capstone-demo-gate/v1",
  "claim": "Patchline provides a release-quality capstone demo where a fresh user downloads four unfamiliar public repositories, finds high-signal data-repair risks, generates bounded interventions, rejects bad output, and regenerates experiment-ready evidence in one documented session.",
  "minimum_public_repos": 4,
  "minimum_ranked_risks": 100,
  "minimum_generated_files": 8,
  "minimum_rejected_examples": 2,
  "minimum_evidence_artifacts": 8,
  "real_code": [
    {
      "id": "lobsters-rails-migrations",
      "repo": "lobsters/lobsters",
      "ref": "3b80b47aa5aaba37ec44413e7d1dc96fcf1585b6",
      "subpath": "db/migrate",
      "ecosystem": "Ruby",
      "framework": "Rails Active Record"
    },
    {
      "id": "django-auth-migrations",
      "repo": "django/django",
      "ref": "9383fae0d55a553be3bda620db87fa9ee8a81478",
      "subpath": "django/contrib/auth/migrations",
      "ecosystem": "Python",
      "framework": "Django migrations"
    },
    {
      "id": "grafana-go-migrations",
      "repo": "grafana/grafana",
      "ref": "a54b2e1e9aaf979938813f6ed9e44de569fe1105",
      "subpath": "pkg/services/sqlstore/migrations",
      "ecosystem": "Go",
      "framework": "Go SQL migrations"
    },
    {
      "id": "airflow-alembic-migrations",
      "repo": "apache/airflow",
      "ref": "707e3168816bedc52f30a2e675af2dfc5b8cd4d8",
      "subpath": "airflow-core/src/airflow/migrations/versions",
      "ecosystem": "Python",
      "framework": "Alembic"
    }
  ],
  "required_outputs": [
    "session.md",
    "summary.json",
    "commands.sh",
    "environment.json",
    "evidence/metrics/metrics.json",
    "evidence/taxonomy/failure-taxonomy.json",
    "evidence/claims/claims-evidence.json",
    "evidence/limitations/limitations-ledger.json",
    "evidence/figures/figures.json",
    "evidence/case-studies/case-studies.json",
    "rejections/rejected-generated.json",
    "checksums.txt"
  ]
}
