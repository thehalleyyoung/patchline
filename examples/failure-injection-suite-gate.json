  "required_probe_kinds": ["ref-drift", "cache-drift", "generated-evidence-drift"],
  "minimum_public_repos": 4,
  "independent_replication_spec": "examples/independent-replication-gate.json",
  "required_outputs": [
    "failure-injection-results.json",
    "failure-injection-results.md",
    "probes/ref-drift.log",
    "probes/cache-drift.log",
    "probes/generated-evidence-drift.log",
    "evidence/independent-replication/independent-replication.json"
  ]
}
