    "overreliance_rate_bp": 1200,
    "mean_review_burden_minutes": 9
  },
  "current": {
    "release": "v1.1.0",
    "explanation_faithfulness_bp": 8950,
    "evidence_citation_coverage_bp": 8800,
    "uncertainty_disclosure_bp": 8600,
    "overreliance_rate_bp": 1150,
    "mean_review_burden_minutes": 9
  },
  "tolerances": {
    "max_faithfulness_drop_bp": 100,
    "max_citation_coverage_drop_bp": 100,
    "max_uncertainty_drop_bp": 100,
