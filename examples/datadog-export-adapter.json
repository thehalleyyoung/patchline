{
  "version": "patchline.datadog-export-adapter/v1",
  "claim": "Datadog-style deploy, incident, trace, log, monitor, SLO, and notebook export adapters work without proprietary APIs and are validated against files from public repositories not designed for Patchline.",
  "minimum_public_repos": 4,
  "required_event_types": [
    "deploy",
    "incident",
    "trace",
    "log",
    "monitor",
    "slo",
    "notebook"
  ],
